{
  "name": "tvplayer-tizen",
  "version": "2.0.0",
  "description": "TVPlayer Smart TV & Desktop - IPTV Player Híbrido Otimizado para Samsung Tizen, LG webOS e Desktop",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "tizen:pack": "npm run build && node scripts/tizen-pack.mjs",
    "tizen:deploy": "npm run build && node scripts/tizen-pack.mjs --deploy",
    "lg:pack": "npm run build && node scripts/lg-pack.mjs",
    "lg:deploy": "npm run build && node scripts/lg-pack.mjs --deploy",
    "electron:dev": "electron electron/main.cjs --dev",
    "electron:pack": "npm run build && node scripts/electron-pack.mjs"
  },
  "dependencies": {
    "hls.js": "^1.5.17",
    "lucide-react": "^0.468.0",
    "mpegts.js": "^1.8.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@webos-tools/cli": "^3.2.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "puppeteer-core": "^25.16.0",
    "terser": "^5.51.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
